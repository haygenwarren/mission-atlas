// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  COMPLETED
  FAILED
}

enum Discipline {
  PLANETARY_SCIENCE
  ASTROPHYSICS
}

enum SpacecraftKind {
  FLYBY
  ORBITER
  LANDER
  ROVER
  ATMOSPHERIC_PROBE
  IMPACTOR
  ROTORCRAFT
  TELESCOPE
}

enum PowerSource {
  SOLAR
  RADIOISOTOPE
  BATTERY
}

enum DestinationKind {
  PLANET
  DWARF_PLANET
  MOON
  ASTEROID
  COMET
  ORBIT
  INTERSTELLAR_SPACE
}

// What kind of event a milestone is.
enum MilestoneKind {
  LAUNCH
  FLYBY
  ARRIVAL
  LANDING
  RELEASE
  SAMPLE_RETURN
  OPERATIONS
  END
}

// How precisely a milestone's date is known: to the day, or only the month
// (for plans not yet fixed to a day).
enum DatePrecision {
  DAY
  MONTH
}

model Mission {
  id                   Int           @id @default(autoincrement())
  name                 String
  slug                 String        @unique
  discipline           Discipline
  status               Status
  launchDate           DateTime
  lastContact          DateTime?
  lastContactTimeKnown Boolean       @default(false)
  endDeclared          DateTime?     @db.Date
  description          String
  // A picture of the spacecraft, credited as its licence asks.
  imageUrl             String?
  imageWidth           Int?
  imageHeight          Int?
  imageCredit          String?
  imageLicense         String?
  imageLicenseUrl      String?
  imageSourceUrl       String?
  sourceUrl            String?
  agencies             Agency[]
  destinations         Destination[]
  spacecraft           Spacecraft[]
  milestones           Milestone[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Spacecraft {
  id                   Int            @id @default(autoincrement())
  name                 String
  slug                 String         @unique
  catalogueId          String?        @unique
  designator           String?
  kind                 SpacecraftKind
  description          String
  status               Status
  lastContact          DateTime?
  lastContactTimeKnown Boolean        @default(false)
  endDeclared          DateTime?      @db.Date
  launchMassKg         Float?
  dryMassKg            Float?
  lengthM              Float?
  diameterM            Float?
  spanM                Float?
  powerSource          PowerSource?
  builders             Builder[]
  imageUrl             String?
  imageCredit          String?
  // Where the craft is now: where it is headed if still on its way, or where
  // it ended up if its mission is over.
  location             Destination    @relation(fields: [locationId], references: [id])
  locationId           Int
  // Its entry in JPL Horizons, e.g. "-31" for Voyager 1.
  horizonsId           String?
  mission              Mission        @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionId            Int
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  milestones Milestone[]

  @@index([missionId])
  @@index([locationId])
}

// A key event in a mission: a flyby, an arrival, a landing, a sample return,
// the end. The launch itself comes from the mission's launch date. Planned
// events are marked until they happen.
model Milestone {
  id           Int           @id @default(autoincrement())
  mission      Mission       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionId    Int
  // The craft it concerns, when it is not the whole mission (Huygens landing
  // on Titan, but not Cassini reaching Saturn with Huygens aboard).
  spacecraft   Spacecraft?   @relation(fields: [spacecraftId], references: [id], onDelete: Cascade)
  spacecraftId Int?
  kind         MilestoneKind
  title        String
  detail       String?
  date         DateTime      @db.Date
  precision    DatePrecision @default(DAY)
  planned      Boolean       @default(false)

  @@index([missionId])
}

model Builder {
  id         Int          @id @default(autoincrement())
  code       String       @unique
  name       String
  spacecraft Spacecraft[]
}

model Agency {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  abbreviation String    @unique
  country      String?
  missions     Mission[]
}

model Destination {
  id         Int             @id @default(autoincrement())
  name       String          @unique
  slug       String          @unique
  kind       DestinationKind
  missions   Mission[]
  spacecraft Spacecraft[]
}
