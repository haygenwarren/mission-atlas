// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  COMPLETED
  FAILED
}

enum Discipline {
  PLANETARY_SCIENCE
  ASTROPHYSICS
}

enum SpacecraftKind {
  FLYBY
  ORBITER
  LANDER
  ROVER
  ATMOSPHERIC_PROBE
  IMPACTOR
  ROTORCRAFT
  TELESCOPE
}

enum PowerSource {
  SOLAR
  RADIOISOTOPE
  BATTERY
}

enum DestinationKind {
  PLANET
  DWARF_PLANET
  MOON
  ASTEROID
  COMET
  ORBIT
  INTERSTELLAR_SPACE
}

model Mission {
  id                   Int           @id @default(autoincrement())
  name                 String
  slug                 String        @unique
  discipline           Discipline
  status               Status
  launchDate           DateTime
  lastContact          DateTime?
  lastContactTimeKnown Boolean       @default(false)
  endDeclared          DateTime?     @db.Date
  description          String
  imageUrl             String?
  imageCredit          String?
  sourceUrl            String?
  agencies             Agency[]
  destinations         Destination[]
  spacecraft           Spacecraft[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Spacecraft {
  id                   Int            @id @default(autoincrement())
  name                 String
  slug                 String         @unique
  catalogueId          String?        @unique
  designator           String?
  kind                 SpacecraftKind
  description          String
  status               Status
  lastContact          DateTime?
  lastContactTimeKnown Boolean        @default(false)
  endDeclared          DateTime?      @db.Date
  launchMassKg         Float?
  dryMassKg            Float?
  lengthM              Float?
  diameterM            Float?
  spanM                Float?
  powerSource          PowerSource?
  builders             Builder[]
  imageUrl             String?
  imageCredit          String?
  mission              Mission        @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionId            Int
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([missionId])
}

model Builder {
  id         Int          @id @default(autoincrement())
  code       String       @unique
  name       String
  spacecraft Spacecraft[]
}

model Agency {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  abbreviation String    @unique
  country      String?
  missions     Mission[]
}

model Destination {
  id       Int             @id @default(autoincrement())
  name     String          @unique
  slug     String          @unique
  kind     DestinationKind
  missions Mission[]
}
